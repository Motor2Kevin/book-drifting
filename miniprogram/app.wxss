page {
  background-color: #f5f3ee;
  color: #2c2825;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #8b6f47;
  color: #ffffff;
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #c9bfae;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: #8b6f47;
  border: 2rpx solid #8b6f47;
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.text-muted {
  color: #999999;
  font-size: 24rpx;
}

.text-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2825;
}

.divider {
  height: 1rpx;
  background-color: #eeeae0;
  margin: 24rpx 0;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-available {
  background: #e8f3e8;
  color: #4a8c4a;
}

.tag-reserved {
  background: #fdf2e0;
  color: #b8860b;
}

.page {
  padding: 20rpx;
  min-height: 100vh;
}

.user-card {
  background: linear-gradient(135deg, #8b6f47 0%, #a78760 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.user-detail {
  margin-left: 24rpx;
  flex: 1;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.user-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85) !important;
}

.stat-row {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eeeae0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #8b6f47;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.menu-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f3ee;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2c2825;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

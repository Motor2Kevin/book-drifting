<view class="page">
  <view class="user-card">
    <image class="user-avatar" src="{{userInfo.avatar || defaultAvatar}}"></image>
    <view class="user-detail">
      <view class="user-nickname">{{userInfo.nickname || '点击登录'}}</view>
      <view class="user-meta text-muted" wx:if="{{userInfo.wechatId}}">微信号：{{userInfo.wechatId}}</view>
      <view class="user-meta text-muted" wx:else>未设置微信号</view>
    </view>
  </view>

  <view class="stat-row">
    <view class="stat-item" bindtap="onTapHolding">
      <view class="stat-num">{{stats.holding}}</view>
      <view class="stat-label">持有中</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onTapReserved">
      <view class="stat-num">{{stats.reserved}}</view>
      <view class="stat-label">已预约</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onTapRead">
      <view class="stat-num">{{stats.read}}</view>
      <view class="stat-label">已传递</view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onTapHolding">
      <view class="menu-icon">📖</view>
      <view class="menu-text">我持有的书</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onTapReserved">
      <view class="menu-icon">⏳</view>
      <view class="menu-text">我预约的书</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onTapRead">
      <view class="menu-icon">📚</view>
      <view class="menu-text">我传递的书</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onTapProfile">
      <view class="menu-icon">⚙️</view>
      <view class="menu-text">个人设置</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onTapAbout">
      <view class="menu-icon">ℹ️</view>
      <view class="menu-text-wrap">
        <view class="menu-text">关于书籍漂流</view>
        <view class="menu-subtitle">玩法说明 · 加入读书群</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>

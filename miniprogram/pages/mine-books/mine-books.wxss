.page {
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeae0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #8b6f47;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 60rpx;
  height: 4rpx;
  background: #8b6f47;
  border-radius: 2rpx;
}

.list {
  padding: 20rpx;
}

.section-tip {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  background: #fdf6e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #8b7d4a;
  line-height: 1.6;
}

.book-row {
  display: flex;
  padding: 20rpx;
  align-items: flex-start;
  gap: 20rpx;
}

.row-cover-wrap {
  flex-shrink: 0;
}

.row-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eeeae0;
  display: block;
}

.row-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #c4c4c4;
}

.row-info {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2825;
}

.row-author {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.row-message {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.row-history {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.row-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.row-action-btn {
  font-size: 22rpx !important;
  padding: 0 20rpx !important;
  height: 60rpx !important;
  line-height: 56rpx !important;
}

.row-more {
  font-size: 36rpx;
  color: #999;
  padding: 0 12rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

.btn-cancel-sm {
  background: #ffffff !important;
  color: #999 !important;
  border: 2rpx solid #ddd !important;
}

.row-status {
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #fdf2e0;
  color: #b8860b;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.page {
  padding: 20rpx;
  min-height: 100vh;
}

.hero-card {
  background: linear-gradient(135deg, #8b6f47 0%, #a78760 100%);
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  color: #ffffff;
}

.hero-emoji {
  font-size: 80rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2825;
  margin-bottom: 24rpx;
}

.wechat-card {
  margin-top: 8rpx;
}

.wechat-tip {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  background: #fdf6e0;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.wechat-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #faf8f3;
  border-radius: 12rpx;
}

.wechat-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 24rpx;
}

.wechat-value {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2825;
  font-family: monospace;
  letter-spacing: 1rpx;
}

.wechat-copy {
  font-size: 26rpx;
  color: #8b6f47;
  padding: 8rpx 20rpx;
  border: 2rpx solid #8b6f47;
  border-radius: 32rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.rule-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #8b6f47;
  color: #ffffff;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.rule-text {
  flex: 1;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2825;
}

.rule-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

.footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
  font-size: 22rpx;
  line-height: 2;
}

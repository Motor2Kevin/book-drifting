.page {
  padding-bottom: 160rpx;
}

.hero {
  position: relative;
  height: 480rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  filter: blur(40rpx);
  transform: scale(1.2);
}

.hero-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
}

.hero-cover {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3);
}

.hero-info {
  position: absolute;
  top: 60rpx;
  left: 280rpx;
  right: 40rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hero-author {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-tags {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.hero-tags .tag {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.tag-city {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.section {
  margin: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2825;
  margin-bottom: 16rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #4a443e;
  padding: 16rpx;
  background: #faf8f3;
  border-left: 6rpx solid #8b6f47;
  border-radius: 4rpx;
}

.owner-row {
  display: flex;
  align-items: center;
}

.owner-avatar-lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eeeae0;
}

.owner-detail {
  margin-left: 20rpx;
}

.owner-name-lg {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c2825;
}

.owner-city {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.history-list {
  padding: 12rpx 0;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  position: relative;
  padding-left: 32rpx;
}

.history-dot {
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #8b6f47;
}

.history-content {
  flex: 1;
}

.history-text {
  font-size: 28rpx;
  color: #2c2825;
}

.history-time {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

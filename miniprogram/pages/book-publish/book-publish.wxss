.page {
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.form-section {
  padding: 24rpx;
}

.hint {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
}

.image-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #faf8f3;
}

.image-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
  z-index: 2;
}

.image-cover-badge {
  position: absolute;
  bottom: 6rpx;
  left: 6rpx;
  padding: 4rpx 12rpx;
  background: rgba(139, 111, 71, 0.9);
  color: #fff;
  border-radius: 6rpx;
  font-size: 20rpx;
  z-index: 1;
}

.image-add {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border: 2rpx dashed #c9bfae;
  border-radius: 12rpx;
  background: #faf8f3;
}

.image-add-icon {
  position: absolute;
  top: 35%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.image-add-text {
  position: absolute;
  bottom: 30%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.image-add-count {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: #c4c4c4;
}

.form-item {
  padding: 20rpx 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2825;
  margin-bottom: 16rpx;
}

.required {
  color: #d96666;
}

.form-input {
  font-size: 30rpx;
  color: #2c2825;
  padding: 10rpx 0;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2c2825;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: #eeeae0;
}

.tip-box {
  margin: 20rpx;
  padding: 16rpx 20rpx;
  background: #fdf6e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #8b7d4a;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

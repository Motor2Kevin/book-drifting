<view class="page">
  <view class="form-section card">
    <view class="form-label">书籍图片 <text class="hint">（最多 5 张，第一张作为封面）</text></view>
    <view class="image-grid">
      <view wx:for="{{form.images}}" wx:key="*this" class="image-item">
        <image class="image-thumb" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}"></image>
        <view class="image-delete" catchtap="onRemoveImage" data-index="{{index}}">×</view>
        <view wx:if="{{index === 0}}" class="image-cover-badge">封面</view>
      </view>
      <view wx:if="{{form.images.length < 5}}" class="image-add" bindtap="onAddImages">
        <view class="image-add-icon">+</view>
        <view class="image-add-text">添加图片</view>
        <view class="image-add-count">{{form.images.length}}/5</view>
      </view>
    </view>
  </view>

  <view class="form-section card">
    <view class="form-item">
      <view class="form-label">书名 <text class="required">*</text></view>
      <input
        class="form-input"
        placeholder="请输入书名"
        value="{{form.title}}"
        bindinput="onInput"
        data-field="title"
        maxlength="50"
      />
    </view>
    <view class="divider"></view>
    <view class="form-item">
      <view class="form-label">作者 <text class="required">*</text></view>
      <input
        class="form-input"
        placeholder="请输入作者"
        value="{{form.author}}"
        bindinput="onInput"
        data-field="author"
        maxlength="30"
      />
    </view>
  </view>

  <view class="form-section card">
    <view class="form-label">给下一位读者的话 <text class="required">*</text></view>
    <textarea
      class="form-textarea"
      placeholder="这本书带给你什么？想对下一位读者说点什么？"
      value="{{form.message}}"
      bindinput="onInput"
      data-field="message"
      maxlength="200"
      auto-height
    />
    <view class="char-count">{{form.message.length}}/200</view>
  </view>

  <view class="tip-box">
    <text wx:if="{{!isEdit}}">📌 发布后，其他读者可以申请这本书，你将通过微信和对方沟通交接。</text>
    <text wx:else>📌 修改后立即生效，已经在浏览这本书的读者会看到最新内容。</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onSubmit" disabled="{{!canSubmit}}">{{isEdit ? '保存修改' : '发布漂流'}}</button>
  </view>
</view>
